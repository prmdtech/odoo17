<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_project_financial_reporting" model="ir.module.category">
        <field name="name">Project Financial Reporting</field>
        <field name="parent_id" ref="base.module_category_services_project"/>
        <field name="sequence">30</field>
    </record>

    <record id="group_project_financial_viewer" model="res.groups">
        <field name="name">Project Financial Viewer</field>
        <field name="category_id" ref="module_category_project_financial_reporting"/>
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]"/>
        <field name="comment">May view and export actual project profitability for allowed companies.</field>
    </record>

    <record id="project_profit_loss_line_company_rule" model="ir.rule">
        <field name="name">Project P&amp;L allocations by allowed company</field>
        <field name="model_id" ref="model_mmp_project_profit_loss_line"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_project_financial_viewer'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
</odoo>
